{
    "name": "webkul/telegram",
    "description": "Telegram Bot API module for bizcrm.",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Webkul\\Telegram\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "Webkul\\Telegram\\Providers\\TelegramServiceProvider"
            ]
        }
    }
}
