# Local port exposed to Laravel for POST /send
PORT=3000

# Where Laravel receives incoming WhatsApp messages
LARAVEL_INCOMING_URL=http://127.0.0.1:8000/api/whatsapp/incoming

# Shared secret with Laravel (must match WHATSAPP_SECRET in Laravel .env)
WHATSAPP_SECRET=change-me

# Baileys auth state folder (relative to this service)
AUTH_DIR=./auth
